# ---------------------------------------------------------------------------
# Contact form (required for enquiries to arrive)
# ---------------------------------------------------------------------------
# The id from your Formspree endpoint (the "xyzabcd" in
# https://formspree.io/f/xyzabcd). Without it the form says so plainly
# rather than posting into the void.
#
# This is the same endpoint the Bersih Clean site uses, so enquiries from
# both sites land in the one Formspree inbox.
VITE_FORMSPREE_ID=movavgrb

# ---------------------------------------------------------------------------
# AI assistant (optional — OFF unless you set both of these)
# ---------------------------------------------------------------------------
# Exactly the string "true" shows the chat bubble. Anything else, including
# leaving this unset, and the widget renders nothing at all.
VITE_AI_ENABLED=false

# The Anthropic API key, read only by the serverless function in api/chat.js.
# NOT VITE_-prefixed, and that matters: Vite inlines every VITE_* variable
# into the public JavaScript bundle, so a key with that prefix would be
# readable by anyone who opens devtools — on a billable credential.
# Set this in Vercel, never in a committed file.
ANTHROPIC_API_KEY=
